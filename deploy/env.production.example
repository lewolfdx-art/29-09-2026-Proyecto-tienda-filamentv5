# Plantilla del .env de producción. Cópiala como .env en la raíz del proyecto
# en el servidor, completa los valores marcados con CAMBIAR y ejecuta
# php artisan app:production-check hasta que todo salga OK.
#
# APP_KEY: genérala UNA sola vez con php artisan key:generate y guárdala en un
# gestor de contraseñas. Los datos de los clientes se cifran con ella: si se
# pierde o se cambia, esos datos no se pueden recuperar.

APP_NAME="Tienda"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CAMBIAR-tu-dominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

# Si hay un proxy/CDN delante (por ejemplo Cloudflare), indica sus IPs separadas por comas.
TRUSTED_PROXIES=

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIAR
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# SMTP del correo de tu dominio (en Hostinger: smtp.hostinger.com, puerto 465, ssl).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=CAMBIAR@tu-dominio.com
MAIL_PASSWORD=CAMBIAR
MAIL_FROM_ADDRESS=CAMBIAR@tu-dominio.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Backups: el zip cifrado se envía por correo cada noche.
BACKUP_DISK=backups
BACKUP_NOTIFICATION_EMAIL=CAMBIAR@correo.com
# Mínimo 12 caracteres. Guárdala: sin ella no se puede abrir el backup.
BACKUP_ARCHIVE_PASSWORD=CAMBIAR
# Solo si mysqldump no está en el PATH del servidor (por ejemplo /usr/bin).
DB_DUMP_BINARY_PATH=

# Correo que recibe los avisos internos cuando un tipo no tiene destinatarios.
INTERNAL_NOTIFICATION_FALLBACK_EMAIL=CAMBIAR@correo.com
BACKUP_EMAIL_MAX_ATTACHMENT_KB=15360
BACKUP_EMAIL_LINK_TTL_DAYS=7
BACKUP_EMAIL_FALLBACK_FREQUENCY_DAYS=14

# Pagos: deja habilitados solo los métodos que tengan teléfono o QR.
PAYMENT_HOLDER="CAMBIAR Nombre del titular"
PAYMENT_PROOF_DISK=local
PAYMENT_PROOF_URL_TTL=15
PAYMENT_YAPE_ENABLED=true
PAYMENT_YAPE_PHONE=CAMBIAR
PAYMENT_YAPE_QR=
PAYMENT_PLIN_ENABLED=true
PAYMENT_PLIN_PHONE=CAMBIAR
PAYMENT_PLIN_QR=
